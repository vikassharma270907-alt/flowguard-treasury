{
  "name": "flowguard",
  "version": "1.0.0",
  "description": "FlowGuard - Autonomous Treasury & Intent Vault Governed by ArmorIQ",
  "main": "api/index.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "mcp": "node server/mcpServer.js --stdio",
    "mcp:server": "node mcp-server/server.mjs",
    "gateway": "node --env-file=.env gateway/server.mjs",
    "test": "node --test test/guide-pdf.test.mjs test/armoriq-auth.test.mjs",
    "test:guide": "node --test test/guide-pdf.test.mjs",
    "test:auth": "node --test test/armoriq-auth.test.mjs",
    "test:enforcement": "node --env-file=.env scripts/test-enforcement.mjs",
    "test:intent": "node --env-file=.env scripts/test-intent-mismatch.mjs",
    "demo": "node --env-file=.env scripts/run-demo.mjs",
    "docs:pdf": "node scripts/generate-user-guide.mjs",
    "docs:overview": "node scripts/generate-flowguard-overview.mjs",
    "postinstall": "npm --prefix client install",
    "install:all": "npm install && npm --prefix client install"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@armoriq/sdk": "^0.6.10",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "pdfkit": "^0.20.2",
    "playwright": "^1.64.1"
  }
}
