# FlowGuard - Airwallex Sandbox & ArmorIQ Environment Configuration
# NOTE: Use sandbox & test credentials ONLY. Never use live production credentials.

# Server Port
PORT=3001

# Airwallex Sandbox Credentials
# Obtain from https://sandbox.airwallex.com under Account > Developer > API keys
AIRWALLEX_CLIENT_ID=your_sandbox_client_id_here
AIRWALLEX_API_KEY=your_sandbox_api_key_here

# Sandbox API Base URL (DO NOT CHANGE for sandbox testing)
AIRWALLEX_API_URL=https://api.sandbox.airwallex.com/api/v1

# ArmorIQ Agent Intent Verification API Key (Optional)
# Obtain from https://platform.armoriq.ai/dashboard/api-keys
# Format: ak_test_... or ak_live_...
# If unset, FlowGuard automatically uses ArmorIQ cryptographic intent simulation
ARMORIQ_API_KEY=ak_test_your_armoriq_api_key_here

# Operational Mode
# Set to 'true' to force mock mode even if keys are provided
AIRWALLEX_MOCK_MODE=false

# Financial Decision Engine Defaults
# Minimum cash reserve floor to protect in USD base currency
DEFAULT_RESERVE_FLOOR=15000
