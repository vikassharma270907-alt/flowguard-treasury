# ArmorIQ Voice Support Gateway & MCP Configuration
# IMPORTANT: Never commit real API keys or secrets to version control.
# Copy this file to .env and fill in your values.

# ArmorIQ Platform Credentials (from https://platform.armoriq.ai)
ARMORIQ_API_KEY=ak_live_your_armoriq_api_key_here
ARMORIQ_ORG_ID=your_armoriq_org_uuid_here
ARMORIQ_AGENT_ID=intentgate-agent
ARMORIQ_MCP_ID=intentgate-support-mcp
ARMORIQ_MCP_UUID=your_registered_mcp_uuid_here
USER_ID=intentgate-operator

# ElevenLabs Conversational Voice API Credentials (from https://elevenlabs.io)
ELEVENLABS_API_KEY=elevenlabs_live_your_actual_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here

# Ports
PORT=3001
GATEWAY_PORT=8790
MCP_PORT=8791

# Security & Tokens
GATEWAY_SHARED_SECRET=your_gateway_shared_secret_here
PLAYGROUND_TOKEN=intentgate-local
MCP_AUTH_TOKEN=your_random_mcp_bearer_token_here

# MCP Public Deployment URL (Registered on ArmorIQ Platform)
MCP_PUBLIC_URL=https://your-tunnel-or-domain.trycloudflare.com/mcp
ARMORIQ_MCP_INTENTGATE_SUPPORT_MCP_AUTH_TYPE=bearer
ARMORIQ_MCP_INTENTGATE_SUPPORT_MCP_TOKEN=your_random_mcp_bearer_token_here

# Approval Governance
REQUIRED_APPROVALS_ISSUE_REFUND=2
HOLD_TTL_MS=900000

# Optional Airwallex Sandbox Credentials (for Treasury Controller sandbox mode)
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_API_URL=https://api.sandbox.airwallex.com/api/v1
AIRWALLEX_MOCK_MODE=false
DEFAULT_RESERVE_FLOOR=15000
